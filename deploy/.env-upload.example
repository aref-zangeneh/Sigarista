# Where to ship the image bundles (used by upload-images.sh / ship.sh).
# Copy this file to `.env-upload` (git-ignored) and adjust the values —
# or export the variables in your shell instead.
#
# SERVER_HOST is the ssh destination, exactly as you would type it:
#   - a host alias defined in ~/.ssh/config  → root@sugarista-web
#   - or raw                                  → ubuntu@203.0.113.10
SERVER_HOST=root@sugarista-web
SERVER_PATH=/opt/sugarista/Sigarista
