POSTGRES_DB=sugarista
POSTGRES_USER=sugarista
POSTGRES_PASSWORD=ChangeMe123!

JWT_ISSUER=Sugarista
JWT_AUDIENCE=SugaristaAdmin
JWT_SIGNING_KEY=ReplaceWithALongRandomSecretForProduction
JWT_EXPIRATION_MINUTES=120

ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_DISPLAY_NAME=Sugarista Admin
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!

# Shared key the Sugarista-PrintAgent (running on the store laptop next to the
# receipt printer) sends in the X-Agent-Key header to /api/print-agent/*.
PRINT_AGENT_KEY=ChangeMe-PrintAgent-Key

APP_PUBLIC_ORIGIN=http://localhost
APP_ADMIN_ORIGIN=http://localhost

# ── Image-based deployment (docker-compose.prod.yml) ──────────────────────
# Where ./scripts/release.sh pushes the images.
IMAGE_REGISTRY=ghcr.io/aref-zangeneh
# Pin a specific build on the server; "latest" follows the newest push.
IMAGE_TAG=latest
# Compose project name. It decides the volume prefix
# (<name>_postgres-data). Keep it identical to the running stack or the
# database will look empty. Uncomment on the server only if needed.
# COMPOSE_PROJECT_NAME=sigarista

Payment__Provider=Mock
Payment__PublicBaseUrl=http://localhost
# Never enable the mock gateway in a real deployment: orders would be marked
# as paid without any money being collected.
Payment__AllowMockInProduction=false

Sms__Provider=Logging
Sms__CafeName=شوگاریستا
# Sms__Provider=Kavenegar
# Sms__ApiKey=your-kavenegar-api-key
# Sms__Sender=10004346

# Maintenance reminders can also be delivered by email (SMTP).
# Keep the provider on Logging for local development: messages are written to the API log.
Email__Provider=Logging
# Email__Provider=Smtp
# Email__Host=smtp.example.com
# Email__Port=587
# Email__FromAddress=maintenance@example.com
# Email__FromName=شوگاریستا
# Email__Username=your-smtp-username
# Email__Password=your-smtp-password
# Email__UseSsl=true
